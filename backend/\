package share

import "fmt"

type Bitset []byte

func (b Bitset) Set(index int) {
	b[index/8] |= (1 << (index % 8))
}

func (b Bitset) IsSet(index int) bool {
	if index < 0 || index/8 >= len(b) {
		return false
	}
	return b[index/8]&(1<<(index%8)) != 0
}

type FileKey struct {
	ShareID   string
	FileIndex int
}

type UploadState struct {
	Bitmask     Bitset
	TotalChunks int
}

type UploadChunkEvent struct {
	ShareID    string
	FileIndex  int
	ChunkIndex int
	IsComplete bool
	Cause      string
}

type UploadManager struct {
	uploadEvents chan UploadChunkEvent
	uploading    map[FileKey]*UploadState
}

func NewUploadManager() *UploadManager {
	m := &UploadManager{
		uploadEvents: make(chan UploadChunkEvent, 1000),
		uploading:    make(map[FileKey]*UploadState),
	}

	go m.run()
}

func (m *UploadManager) TrackShareUpload(share Share) error {
	for _, f := range share.Files {
		numChunks := (f.Size + CHUNK_SIZE - 1) / CHUNK_SIZE
		numBytes := (numChunks + 7) / 8

		key := FileKey{ShareID: share.ID, FileIndex: f.Index}
		m.uploading[key] = &UploadState{Bitmask: make([]byte, numBytes), TotalChunks: int(numChunks)}
	}

	return nil
}

func (m *UploadManager) markChunkUploaded(shareID string, fileIndex int, chunkIndex int) error {
	state, err := m.findUploadState(shareID, fileIndex)
	if err != nil {
		return err
	}

	if chunkIndex >= state.TotalChunks || chunkIndex < 0 {
		return fmt.Errorf("chunk index %d out of bounds", chunkIndex)
	}

	if state.Bitmask.IsSet(chunkIndex) {
		return fmt.Errorf("chunk %d was already uploaded", chunkIndex)
	}

	state.Bitmask.Set(chunkIndex)
	return nil
}

func (m *UploadManager) findUploadState(shareID string, fileIndex int) (*UploadState, error) {
	key := FileKey{ShareID: shareID, FileIndex: fileIndex}
	state, ok := m.uploading[key]

	if !ok {
		return nil, fmt.Errorf("Upload state for share %s, file %d not found", shareID, fileIndex)
	}

	return state, nil
}

func (m *UploadManager) run() {
	for e := range m.uploadEvents {
		err := m.markChunkUploaded(e.ShareID, e.FileIndex, e.ChunkIndex)
